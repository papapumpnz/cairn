{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.local/schemas/teacher-packet.schema.json",
  "title": "CAIRN untrusted structured teacher packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "domain", "origin", "semantic_intents", "mechanism_lessons", "collection_mechanism_lessons", "knowledge_claims", "procedures", "counterexamples", "uncertainties"],
  "properties": {
    "packet_version": {"const": "1.0"},
    "domain": {"type": "string", "minLength": 1, "maxLength": 128},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "semantic_intents": {
      "type": "array",
      "items": {"$ref": "#/$defs/intent"},
      "maxItems": 10000
    },
    "mechanism_lessons": {
      "type": "array",
      "items": {"$ref": "#/$defs/mechanism"},
      "maxItems": 10000
    },
    "collection_mechanism_lessons": {
      "type": "array",
      "items": {"$ref": "#/$defs/collection_mechanism"},
      "maxItems": 10000
    },
    "knowledge_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/knowledge_claim"},
      "maxItems": 10000
    },
    "procedures": {
      "type": "array",
      "items": {"$ref": "#/$defs/procedure"},
      "maxItems": 10000
    },
    "counterexamples": {
      "type": "array",
      "items": {"$ref": "#/$defs/counterexample"},
      "maxItems": 100000
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string", "maxLength": 4096},
      "maxItems": 10000
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utterance", "intent", "language", "operation", "held_out_utterances"],
      "properties": {
        "utterance": {"type": "string", "minLength": 1, "maxLength": 4096},
        "intent": {"enum": ["GenerateProgram"]},
        "language": {"enum": ["Python"]},
        "operation": {"enum": ["AddNumbers", "IllustrativeFunction"]},
        "held_out_utterances": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096},
          "maxItems": 10000
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "examples", "literals"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "parameters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputs", "output"],
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
                "minProperties": 1,
                "maxProperties": 256
              },
              "output": {"type": "integer", "minimum": -1000000, "maximum": 1000000}
            }
          },
          "minItems": 1,
          "maxItems": 100000
        },
        "literals": {
          "type": "array",
          "items": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
          "maxItems": 256,
          "uniqueItems": true
        }
      }
    },
    "collection_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maximum_cardinality", "episodes"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "maximum_cardinality": {"type": "integer", "minimum": 1, "maximum": 100000},
        "episodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["episode", "inputs", "outputs"],
            "properties": {
              "episode": {"type": "string", "minLength": 1, "maxLength": 256},
              "inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100000,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": -65535, "maximum": 65535}
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100000,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": -65535, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "knowledge_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "verification_method", "evidence"],
      "properties": {
        "subject": {"type": "string", "minLength": 1, "maxLength": 1024},
        "predicate": {"type": "string", "minLength": 1, "maxLength": 1024},
        "object": {"type": "string", "minLength": 1, "maxLength": 4096},
        "verification_method": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096},
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goal", "parameters", "steps", "preconditions", "postconditions"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "goal": {"type": "string", "minLength": 1, "maxLength": 4096},
        "parameters": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 256},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "operation", "depends_on"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 256},
              "operation": {"type": "string", "minLength": 1, "maxLength": 4096},
              "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 10000}
            }
          }
        },
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 10000},
        "postconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 10000}
      }
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism_name", "inputs", "forbidden_output", "reason"],
      "properties": {
        "mechanism_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "inputs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -1000000, "maximum": 1000000}, "minProperties": 1, "maxProperties": 256},
        "forbidden_output": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
