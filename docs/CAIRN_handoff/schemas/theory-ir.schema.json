{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.local/schemas/theory-ir.schema.json",
  "title": "CAIRN Theory IR exchange schema",
  "description": "Transport-level validation. The Rust type checker imposes stronger RKL typing, scope, totality, and termination constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics_version",
    "theory_id",
    "observation_signature",
    "roles",
    "definitions",
    "rules",
    "schedule",
    "renderer",
    "proof_roots",
    "cost"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "semantics_version": {
      "type": "string",
      "minLength": 1
    },
    "theory_id": {
      "$ref": "#/$defs/hash"
    },
    "observation_signature": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "schedule": {
      "$ref": "#/$defs/schedule"
    },
    "renderer": {
      "$ref": "#/$defs/renderer"
    },
    "proof_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hash"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "origin": {
      "type": "array",
      "items": {
        "enum": [
          "event-cover",
          "analogy",
          "anti-unification",
          "constraint-fill",
          "cegis",
          "invention",
          "memory-proposal",
          "planner"
        ]
      },
      "uniqueItems": true
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "falsification": {
      "$ref": "#/$defs/falsification"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "expr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "type",
        "args"
      ],
      "properties": {
        "op": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "type": {
          "enum": [
            "Bool",
            "Int",
            "Atom",
            "Coord",
            "Vector",
            "CellSet",
            "Entity",
            "EntitySet",
            "Relation",
            "FiniteField",
            "Canvas",
            "Transform",
            "Direction",
            "Event",
            "Schedule",
            "SymbolMeaning",
            "Unit"
          ]
        },
        "args": {
          "type": "array"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "uniqueItems": true
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "binder"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string"
        },
        "binder": {
          "$ref": "#/$defs/expr"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters",
        "return_type",
        "body",
        "admission"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "return_type": {
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/expr"
        },
        "recursive": {
          "type": "boolean",
          "default": false
        },
        "progress_measure": {
          "$ref": "#/$defs/expr"
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "exact_on_evidence",
            "total",
            "grounded",
            "core_reduction",
            "description_gain"
          ],
          "properties": {
            "scope": {
              "enum": [
                "task-local",
                "quarantined-candidate",
                "promoted"
              ]
            },
            "exact_on_evidence": {
              "const": true
            },
            "total": {
              "const": true
            },
            "grounded": {
              "const": true
            },
            "core_reduction": {
              "type": "integer",
              "minimum": 1
            },
            "description_gain": {
              "type": "number"
            },
            "support_geometry_artifact": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "quantifiers",
        "guard",
        "effects",
        "priority"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "quantifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var",
              "domain"
            ],
            "properties": {
              "var": {
                "type": "string"
              },
              "domain": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        "guard": {
          "$ref": "#/$defs/expr"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          },
          "minItems": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "parallel"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "order"
          ],
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edges"
          ],
          "properties": {
            "kind": {
              "const": "dependency-dag"
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "order"
          ],
          "properties": {
            "kind": {
              "const": "decision-list"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rule_ids",
            "max_steps",
            "progress_measure"
          ],
          "properties": {
            "kind": {
              "const": "bounded-fixpoint"
            },
            "rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "progress_measure": {
              "$ref": "#/$defs/expr"
            }
          }
        }
      ]
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "paint_order",
        "conflict_policy",
        "crop"
      ],
      "properties": {
        "canvas": {
          "$ref": "#/$defs/expr"
        },
        "paint_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_policy": {
          "enum": [
            "reject",
            "same-color-idempotent",
            "priority",
            "last-write"
          ]
        },
        "crop": {
          "$ref": "#/$defs/expr"
        },
        "background": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description_bits",
        "unjustified_constants",
        "unexercised_axes",
        "execution_cost"
      ],
      "properties": {
        "description_bits": {
          "type": "number",
          "minimum": 0
        },
        "unjustified_constants": {
          "type": "integer",
          "minimum": 0
        },
        "unexercised_axes": {
          "type": "integer",
          "minimum": 0
        },
        "execution_cost": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "falsification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leave_one_out": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "equivariance_rederivation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "irrelevance_stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decomposition_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "counterfactual_discrimination": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
